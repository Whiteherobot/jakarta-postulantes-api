<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
   xmlns="https://jakarta.ee/xml/ns/persistence"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="
        https://jakarta.ee/xml/ns/persistence
        https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

   <persistence-unit name="pruebaxxPersistenceUnit" transaction-type="JTA">
      <!-- Usar DataSource por defecto del servidor -->
      <jta-data-source>java:comp/DefaultDataSource</jta-data-source>

      <!-- Opcional: registrar clases manualmente (si no usas auto-scan) -->
      <!-- <class>ec.edu.ups.pruebaxx.modelo.Candidato</class> -->

      <properties>
         <!-- Generación automática del esquema -->
         <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
         <property name="hibernate.show_sql" value="true"/>
         <property name="hibernate.format_sql" value="true"/>
         <!-- Dialecto opcional si quieres forzar uno específico -->
         <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
      </properties>
   </persistence-unit>

</persistence>
